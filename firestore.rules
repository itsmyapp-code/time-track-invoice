rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      
      match /prices/{priceId} {
        allow read: if true;
      }
      
      match /tax_rates/{taxRateId} {
        allow read: if true;
      }
    }
    
    match /users/{userId} {
      // Admin can do anything, users can only read/write their own
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'martin@cozens.me.uk');
      
      // Allow access to *any* subcollection under /users/{userId}
      match /{document=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'martin@cozens.me.uk');
      }
    }
    
    // Explicitly allow admin to query the users collection
    match /users {
      allow list: if request.auth != null && request.auth.token.email == 'martin@cozens.me.uk';
    }
  }
}
